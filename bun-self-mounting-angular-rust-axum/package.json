{
  "name": "@sleet-ai-lab/frontend-middleman-backend-bun-frontend-angular",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "middleman"
  ],
  "scripts": {
    "build": "bun run build:middleman && bun run build.ts",
    "build:middleman": "bun run --filter @sleet-ai-lab/frontend-middleman-backend-bun-middleman-angular build",
    "typecheck": "bun run --filter '*' typecheck && tsc --noEmit",
    "render:check": "bun run scripts/render_check.ts",
    "clean": "bun run --filter @sleet-ai-lab/frontend-middleman-backend-bun-middleman-angular clean && rm -rf static .aot"
  },
  "dependencies": {
    "@angular/common": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@sleet-ai-lab/frontend-middleman-backend-bun-middleman-angular": "workspace:*",
    "rxjs": "^7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/compiler": "^22.2.5",
    "@angular/compiler-cli": "^22.2.5",
    "@babel/core": "^8.1.0",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.0"
  }
}
